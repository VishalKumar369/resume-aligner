PROJECT_NAME="Resume-JD-Aligner"
ENVIRONMENT="development"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="resume_jd_aligner"

# Security
SECRET_KEY="generate-this-with-openssl-rand-hex-32"

# AI
# Leave the key blank to run on the deterministic heuristic parser.
# Free-tier keys: Gemini -> aistudio.google.com/apikey, Groq -> console.groq.com/keys
AI_PROVIDER="gemini" # openai, groq, gemini
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Model selections
LLM_MODEL="gpt-4o-mini"
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_MODEL="gemini-2.0-flash"

# Redis
REDIS_URL="redis://localhost:6379/0"
USE_REDIS=false

# Storage
STORAGE_TYPE="local" # Options: local, cloudinary, firebase
UPLOAD_DIR="uploads"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_STORAGE_BUCKET=""
