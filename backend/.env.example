PROJECT_NAME="Resume-JD-Aligner"
ENVIRONMENT="development"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="resume_jd_aligner"

# Security
SECRET_KEY="generate-this-with-openssl-rand-hex-32"

# AI
# Leave the key blank to run on the deterministic heuristic parser.
# Free-tier keys: Gemini -> aistudio.google.com/apikey, Groq -> console.groq.com/keys
AI_PROVIDER="gemini" # openai, groq, gemini
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Model selections
LLM_MODEL="gpt-4o-mini"
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_MODEL="gemini-2.5-flash"

# Which features may spend a model call. Free tiers are metered per DAY
# (Gemini reports 20/day for a free project), so the budget goes where rules
# cannot compete. The heuristic extractors already parse at confidence 1.0;
# rewriting prose is what they cannot do. See backend/docs/llm-budget.md
LLM_FOR_RESUME_EXTRACTION=false
LLM_FOR_JD_EXTRACTION=false
LLM_FOR_ALIGNMENT=false
LLM_FOR_BULLET_REWRITING=true

# Seconds to stop attempting calls after a quota rejection
LLM_QUOTA_COOLDOWN_SECONDS=900

# Redis
REDIS_URL="redis://localhost:6379/0"
USE_REDIS=false

# Storage
STORAGE_TYPE="local" # Options: local, cloudinary, firebase
UPLOAD_DIR="uploads"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_STORAGE_BUCKET=""
